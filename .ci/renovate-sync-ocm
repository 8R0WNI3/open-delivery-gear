#!/usr/bin/env python3

import os
import json
import re
import subprocess
import sys
import tarfile
import tempfile


own_dir = os.path.dirname(__file__)
repo_dir = os.path.abspath(os.path.join(own_dir, os.pardir))
BASE_COMPONENT_FILE = os.path.join(repo_dir, '.ocm', 'base-component.yaml')
EXTENSION_DEFINITIONS_FILE = os.path.join(repo_dir, 'extension-definitions.yaml')

OCM_REPO = 'europe-docker.pkg.dev/gardener-project/releases'
OCM_CLI_VERSION = '0.22'
RELEASE_NOTES_DIR = os.path.join(repo_dir, '.ocm', 'release-notes')
RELEASE_NOTES_RESOURCE = 'release-notes-archive'


def image_reference_changed():
    try:
        result = subprocess.run(
            ['git', 'diff', '--', BASE_COMPONENT_FILE],
            capture_output=True, text=True, check=True,
            cwd=repo_dir,
        )
        for line in result.stdout.splitlines():
            if line.startswith(('+', '-')) and not line.startswith(('+++', '---')):
                if 'imageReference:' in line:
                    return True
        return False
    except (subprocess.CalledProcessError, FileNotFoundError):
        return True


def derive_version(image_reference):
    ref = image_reference.split('@')[0]
    return ref.rsplit(':', 1)[-1].removeprefix('distroless-')


def update_base_component(filepath):
    with open(filepath) as f:
        lines = f.readlines()

    result = []
    pending_version = None
    current_type = None
    current_name = None
    helmchart_versions = {}

    for line in lines:
        if line.startswith('- '):
            pending_version = None
            current_type = None
            current_name = None

        match = re.match(r'^    imageReference:\s*(.+)$', line)
        if match:
            ref = match.group(1).strip()
            pending_version = derive_version(ref)
            result.append(line)
            continue

        match = re.match(r'^  name:\s*(.+)$', line)
        if match:
            current_name = match.group(1).strip()
            result.append(line)
            continue

        match = re.match(r'^  type:\s*(.+)$', line)
        if match:
            current_type = match.group(1).strip()
            result.append(line)
            continue

        match = re.match(r'^  version:\s*(.+)$', line)
        if match and pending_version is not None:
            result.append(f'  version: {pending_version}\n')
            if current_type == 'helmChart/v1':
                helmchart_versions[current_name] = pending_version
            pending_version = None
            continue

        result.append(line)

    with open(filepath, 'w') as f:
        f.writelines(result)

    return helmchart_versions


def update_extension_definitions(filepath, helmchart_versions):
    if not helmchart_versions:
        return

    with open(filepath) as f:
        lines = f.readlines()

    # Line-based replacement of the 'version:' of matching 'artefact:' blocks.
    # Deliberately avoids PyYAML: it is not available in the renovate container,
    # and a yaml round-trip would reformat the whole file.
    result = []
    artefact_indent = None
    pending_version = None

    for line in lines:
        match = re.match(r'^(\s*)(?:-\s*)?artefact:\s*$', line)
        if match:
            artefact_indent = len(match.group(1)) + (2 if line.lstrip().startswith('-') else 0)
            pending_version = None
            result.append(line)
            continue

        if artefact_indent is not None and line.strip():
            indent = len(line) - len(line.lstrip())
            if indent <= artefact_indent:
                artefact_indent = None
                pending_version = None
            else:
                match = re.match(r'^\s*name:\s*(\S+)\s*$', line)
                if match:
                    pending_version = helmchart_versions.get(match.group(1))
                    result.append(line)
                    continue

                match = re.match(r'^(\s*)version:.*$', line)
                if match and pending_version is not None:
                    result.append(f'{match.group(1)}version: {pending_version}\n')
                    pending_version = None
                    continue

        result.append(line)

    with open(filepath, 'w') as f:
        f.writelines(result)


def component_references_changed(diff_text=None):
    '''
    Parses `git diff` of the base-component and returns the OCM component
    references whose version was bumped, as (component_name, old, new) tuples.

    A bump appears in the diff as a `- version: <old>` / `+ version: <new>` pair
    under the (context-line) `componentName:` it belongs to.
    '''
    if diff_text is None:
        result = subprocess.run(
            ['git', 'diff', '--', BASE_COMPONENT_FILE],
            capture_output=True, text=True, check=True,
            cwd=repo_dir,
        )
        diff_text = result.stdout

    current_component = None
    old_version = None
    new_version = None
    changes = []

    def flush():
        if current_component and old_version and new_version:
            changes.append((current_component, old_version, new_version))

    for line in diff_text.splitlines():
        if line.startswith(('+++', '---')):
            continue

        body = line[1:] if line[:1] in ('+', '-', ' ') else line

        match = re.match(r'^\s*(?:- )?componentName:\s*(.+)$', body)
        if match:
            flush()
            current_component = match.group(1).strip()
            old_version = None
            new_version = None
            continue

        match = re.match(r'^\s*version:\s*(.+)$', body)
        if match and current_component:
            if line.startswith('-'):
                old_version = match.group(1).strip()
            elif line.startswith('+'):
                new_version = match.group(1).strip()
            continue

    flush()
    return changes


def _parse_version(version):
    # rc releases sort below the final release of the same version
    version = version.lstrip('v')
    base, _, pre = version.partition('-')
    parts = [int(p) for p in base.split('.')]
    if pre.startswith('rc.'):
        return tuple(parts) + (0, int(pre.split('.')[1]))
    return tuple(parts) + (1, 0)


def install_ocm_cli():
    bindir = tempfile.mkdtemp(prefix='ocm-cli-')
    env = {
        **os.environ,
        'OCM_VERSION': OCM_CLI_VERSION,
        'OCM_BIN_DIR': bindir,
    }
    subprocess.run(
        ['bash', '-c', 'curl -sfL https://ocm.software/install-cli.sh | bash'],
        check=True,
        env=env,
    )
    return os.path.join(bindir, 'ocm')


def upgrade_path(ocm_bin, component_name, old_version, new_version):
    '''
    Returns the versions in the range (old_version, new_version] in ascending
    order, i.e. every released version the upgrade steps over, target included.
    '''
    result = subprocess.run(
        [ocm_bin, 'get', 'cvs', f'{OCM_REPO}//{component_name}', '-o', 'json'],
        capture_output=True, text=True, check=True,
    )
    data = json.loads(result.stdout)
    all_versions = [entry['component']['version'] for entry in data]

    low = _parse_version(old_version)
    high = _parse_version(new_version)

    in_range = [v for v in all_versions if low < _parse_version(v) <= high]
    return sorted(in_range, key=_parse_version)


def write_release_notes(ocm_bin, component_name, old_version, new_version):
    os.makedirs(RELEASE_NOTES_DIR, exist_ok=True)

    for version in upgrade_path(ocm_bin, component_name, old_version, new_version):
        with tempfile.NamedTemporaryFile(suffix='.tar') as tmp:
            download = subprocess.run(
                [
                    ocm_bin, 'download', 'resource',
                    f'{OCM_REPO}//{component_name}:{version}',
                    '--identity', f'name={RELEASE_NOTES_RESOURCE}',
                    '--extraction-policy', 'disable',
                    '--output', tmp.name,
                ],
                capture_output=True, text=True,
            )
            if download.returncode != 0:
                # older component versions may not carry the resource
                print(
                    f'no {RELEASE_NOTES_RESOURCE} for {component_name}:{version} '
                    f'(skipping): {download.stderr.strip()}',
                    file=sys.stderr,
                )
                continue

            with tarfile.open(tmp.name) as tar:
                tar.extractall(path=RELEASE_NOTES_DIR, filter='data')


def main():
    if changed_references := component_references_changed():
        ocm_bin = install_ocm_cli()
        for component_name, old_version, new_version in changed_references:
            write_release_notes(ocm_bin, component_name, old_version, new_version)

    if image_reference_changed():
        helmchart_versions = update_base_component(BASE_COMPONENT_FILE)
        update_extension_definitions(EXTENSION_DEFINITIONS_FILE, helmchart_versions)


if __name__ == '__main__':
    main()
